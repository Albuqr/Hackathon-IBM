# Copie para .env e preencha. Nunca commite o .env. Valores abaixo = padrão do código; segredos vazios.

# --- LLM (middleware/llm.py) ---
# Chave da Anthropic. Sem ela o núcleo roda degradado (regras por fonte, chat indisponível).
ANTHROPIC_API_KEY=
# Modelo usado por classificação, chat e previsão (padrão: claude-haiku-5-5).
CRISIS_LLM_MODELO=claude-haiku-5-5
# Teto de tokens da resposta.
CRISIS_LLM_MAX_TOKENS=1024
# Timeout da chamada ao provedor, em segundos.
CRISIS_LLM_TIMEOUT=30
# Teto de chamadas ao provedor por dia UTC (contador em memória, por processo).
CRISIS_LLM_LIMITE_DIARIO=500
# Máximo de eventos novos classificados pelo LLM por ciclo de /ingest (o resto vai às regras por fonte).
CRISIS_LLM_MAX_POR_CICLO=30

# --- /chat (middleware/chat.py) ---
# Tamanho máximo da mensagem em caracteres, contexto incluído.
CRISIS_CHAT_MAX_CHARS=6000

# --- API / middleware (middleware/main.py, middleware/seguranca.py) ---
# Caminho do banco SQLite.
DB_PATH=data/crisis.db
# Origens aceitas no CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:5000,http://localhost:5173
# Segredo do qual deriva o X-Crisis-Token (ADR 0004). Vazio ou o valor de dev deixa a API aberta.
SECRET_KEY=

# --- Telegram (telegram_bot/bot.py, tools/notify_telegram.py) ---
# Token do bot.
TG_TOKEN=
# URL da API vista pelo bot (e pelo frontend).
API_URL=http://middleware:8000

# --- Tools (tools/save_classification.py, tools/br_salvar_eventos.py) ---
# URL da API usada por save_classification (padrão no código aponta para o VPS do projeto).
VPS_API_URL=
# Token mandado no X-Crisis-Token por essas tools; sem ele o cabeçalho não é enviado.
CRISIS_API_TOKEN=

# --- Legado watsonx (usado só pelo provedor watsonx do Brasil, tools publicadas, import_all.py e test_agent.py) ---
# WO_API_KEY=
# WO_INSTANCE=
# ORCHESTRATOR_AGENT_ID=
# WATSONX_APIKEY=
# WATSONX_PROJECT_ID=

# --- ReliefWeb (tools/fetch_reliefweb.py) ---
# Appname enviado à API v2 da ReliefWeb (padrão do código: hktn26-crisis; a API pode exigir um appname aprovado).
RELIEFWEB_APPNAME=hktn26-crisis
